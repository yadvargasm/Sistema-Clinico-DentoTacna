<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <connectionStrings>
        <!--
          Cambien "Data Source" según su equipo:
            SQL Server local (instancia por defecto) : Data Source=.
            SQL Server Express                       : Data Source=.\SQLEXPRESS
            Azure SQL : Server=tcp:<servidor>.database.windows.net,1433;Initial Catalog=DentoTacnaDB;User ID=<usuario>;Password=<clave>;Encrypt=True;
          No suban a GitHub una cadena con usuario y clave reales.
        -->
        <add name="DentoTacnaDB"
             connectionString="Data Source=.;Initial Catalog=DentoTacnaDB;Integrated Security=True;"
             providerName="System.Data.SqlClient" />
    </connectionStrings>
</configuration>
